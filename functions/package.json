{
  "name": "functions",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle": "esbuild src/index.ts --bundle --minify --platform=node --target=node22 --format=cjs --outfile=lib/index.js --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/*",
    "build": "npm run typecheck && npm run bundle"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@manage-users/shared": "*",
    "esbuild": "^0.28.0",
    "typescript": "~6.0.2"
  }
}
