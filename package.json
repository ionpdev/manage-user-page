{
  "name": "manage-user-page",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*",
    "functions"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:shared": "npm run build -w @manage-users/shared",
    "build:functions": "npm run build -w functions",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "emulators": "npm run build:shared && npm run build:functions && firebase emulators:start --project demo-user-management-console",
    "deploy": "npm run build:shared && npm run build && firebase deploy --only firestore:rules,functions,hosting"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@manage-users/shared": "*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "firebase-tools": "^15.19.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
